<Layouts.app flash={@flash} meta_pixel_id={@meta_pixel_id}>
  <div id="shop-visit" phx-hook="ShopVisit" phx-update="ignore"></div>
  <%!-- Hero: only on the unfiltered front page --%>
  <section
    :if={is_nil(@category) and @filters == %{}}
    id="shop-hero"
    class="relative mb-8 overflow-hidden rounded-3xl bg-gradient-to-br from-orange-400 via-orange-500 to-amber-500 px-6 py-10 text-white sm:px-12 sm:py-14"
  >
    <div class="pointer-events-none absolute -right-10 -top-16 size-64 rounded-full bg-white/15 blur-2xl">
    </div>
    <div class="pointer-events-none absolute -bottom-20 left-1/3 size-56 rounded-full bg-amber-200/30 blur-2xl">
    </div>
    <div class="relative max-w-2xl">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-orange-100">
        Kasutatud lasteriided
      </p>
      <h1 class="mt-2 font-[ui-rounded,'Nunito',system-ui,sans-serif] text-4xl font-black leading-tight tracking-tight sm:text-5xl">
        Ilusad riided, <br class="hidden sm:block" />uus elu.
      </h1>
      <p class="mt-3 max-w-lg text-base text-orange-50 sm:text-lg">
        Käsitsi valitud kvaliteetsed lasteriided ja jalanõud soodsa hinnaga. Iga ese on päris, ühe eksemplariga.
      </p>
    </div>
  </section>

  <.breadcrumbs :if={@category} crumbs={breadcrumb_trail(@tree, @category, @filters)} />

  <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h2
        id="shop-title"
        class="font-[ui-rounded,'Nunito',system-ui,sans-serif] text-2xl font-black tracking-tight text-stone-900 sm:text-3xl"
      >
        {if @category, do: @category.name_et, else: "Kõik tooted"}
      </h2>
      <p id="shop-count" class="mt-1 text-sm text-stone-500">
        {@total} {if @total == 1, do: "ese", else: "eset"}
      </p>
    </div>

    <.form
      for={@search_form}
      id="shop-search-form"
      phx-change="search"
      phx-submit="search"
      class="relative w-full sm:max-w-md"
    >
      <.icon
        name="hero-magnifying-glass"
        class="pointer-events-none absolute left-4 top-1/2 size-5 -translate-y-1/2 text-stone-400"
      />
      <.input
        field={@search_form[:q]}
        type="search"
        placeholder="Otsi: jope, Reima, 104 …"
        autocomplete="off"
        phx-debounce="300"
        class="w-full rounded-full border border-orange-200 bg-white py-3 pl-12 pr-4 text-base text-stone-800 shadow-sm outline-none transition placeholder:text-stone-400 focus:border-orange-400 focus:ring-4 focus:ring-orange-200/60"
      />
    </.form>
  </div>

  <div class="grid gap-8 lg:grid-cols-[15rem_minmax(0,1fr)]">
    <aside id="shop-filters" class="lg:sticky lg:top-20 lg:self-start">
      <button
        id="filters-toggle"
        type="button"
        phx-click={JS.toggle(to: "#filters-panel")}
        class="mb-3 flex w-full items-center justify-between rounded-full border border-orange-200 bg-white px-5 py-2.5 text-sm font-bold text-stone-700 lg:hidden"
      >
        <span class="flex items-center gap-2">
          <.icon name="hero-adjustments-horizontal" class="size-5 text-orange-500" /> Filtrid
        </span>
        <.icon name="hero-chevron-down-micro" class="size-4" />
      </button>

      <div id="filters-panel" class="hidden space-y-6 lg:block">
        <%!-- Category navigation --%>
        <% audiences = CategoryTree.audiences(@tree, @category_counts) %>
        <nav id="category-nav" aria-label="Kategooriad">
          <ul
            :if={length(audiences) > 1}
            id="audience-switcher"
            class="mb-3 flex flex-wrap gap-1.5"
          >
            <li :for={audience <- audiences}>
              <.link
                id={"audience-#{audience.slug}"}
                patch={audience_path(@tree, audience, @filters)}
                class={[
                  "inline-flex rounded-full border px-3 py-1 text-sm transition",
                  if(CategoryTree.audience(@tree, @category).id == audience.id,
                    do: "border-orange-500 bg-orange-500 font-bold text-white",
                    else: "border-orange-200 bg-white text-stone-600 hover:border-orange-400"
                  )
                ]}
              >
                {audience.name_et}
              </.link>
            </li>
          </ul>
          <h3 class="mb-2 text-xs font-bold uppercase tracking-[0.15em] text-stone-400">
            Kategooriad
          </h3>
          <.link
            :if={@category}
            id="category-nav-all"
            patch={shop_path(@tree, nil, @filters)}
            class="mb-1 flex items-center gap-1 text-sm text-stone-500 transition-colors hover:text-orange-600"
          >
            <.icon name="hero-arrow-left-micro" class="size-4" /> Kõik tooted
          </.link>
          <ul class="space-y-0.5">
            <%= for {family, children} <- category_nav(@tree, @category, @category_counts) do %>
              <li>
                <.link
                  id={"category-link-#{family.slug}"}
                  patch={shop_path(@tree, family, @filters)}
                  class={[
                    "flex items-center justify-between rounded-lg px-2.5 py-1.5 text-sm transition-colors",
                    if(@category && family.id == @category.id,
                      do: "bg-orange-100 font-bold text-orange-700",
                      else: "text-stone-600 hover:bg-orange-50 hover:text-orange-600"
                    )
                  ]}
                >
                  <span>{family.name_et}</span>
                  <span class="text-xs text-stone-400">
                    {Map.get(@category_counts, family.id, 0)}
                  </span>
                </.link>
                <ul
                  :if={children != []}
                  class="ml-3 mt-0.5 space-y-0.5 border-l border-orange-100 pl-2"
                >
                  <li :for={child <- children}>
                    <.link
                      id={"category-link-#{child.slug}"}
                      patch={shop_path(@tree, child, @filters)}
                      class={[
                        "flex items-center justify-between rounded-lg px-2.5 py-1 text-sm transition-colors",
                        if(@category && child.id == @category.id,
                          do: "bg-orange-100 font-bold text-orange-700",
                          else: "text-stone-600 hover:bg-orange-50 hover:text-orange-600"
                        )
                      ]}
                    >
                      <span>{child.name_et}</span>
                      <span class="text-xs text-stone-400">
                        {Map.get(@category_counts, child.id, 0)}
                      </span>
                    </.link>
                  </li>
                </ul>
              </li>
            <% end %>
          </ul>
        </nav>

        <%!-- Season: combinable toggles, persist across category navigation --%>
        <section id="facet-season">
          <h3 class="mb-2 text-xs font-bold uppercase tracking-[0.15em] text-stone-400">
            Hooaeg
          </h3>
          <ul class="flex flex-wrap gap-1.5">
            <li :for={{season, label, count} <- season_pills(@facets)}>
              <.link
                id={"season-#{season}"}
                patch={shop_path(@tree, @category, toggle_season(@filters, season))}
                aria-pressed={to_string(season in (@filters[:season] || []))}
                class={[
                  "inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-sm transition",
                  if(season in (@filters[:season] || []),
                    do: "border-orange-500 bg-orange-500 font-bold text-white",
                    else:
                      "border-orange-200 bg-white text-stone-600 hover:border-orange-400 hover:text-orange-600"
                  )
                ]}
              >
                {label} <span class="text-xs opacity-60">{count}</span>
              </.link>
            </li>
          </ul>
        </section>

        <%!-- Waterproof: single toggle, persists across category navigation --%>
        <section
          :if={waterproof_count(@facets) > 0 or @filters[:waterproof]}
          id="facet-waterproof"
        >
          <h3 class="mb-2 text-xs font-bold uppercase tracking-[0.15em] text-stone-400">
            Veekindel
          </h3>
          <ul class="flex flex-wrap gap-1.5">
            <li>
              <.link
                id="facet-waterproof-true"
                patch={shop_path(@tree, @category, toggle_filter(@filters, :waterproof, true))}
                aria-pressed={to_string(@filters[:waterproof] == true)}
                class={[
                  "inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-sm transition",
                  if(@filters[:waterproof],
                    do: "border-orange-500 bg-orange-500 font-bold text-white",
                    else:
                      "border-orange-200 bg-white text-stone-600 hover:border-orange-400 hover:text-orange-600"
                  )
                ]}
              >
                Veekindel <span class="text-xs opacity-60">{waterproof_count(@facets)}</span>
              </.link>
            </li>
          </ul>
        </section>

        <%!-- Enum facets --%>
        <%= for key <- [:gender, :age_group],
                links = facet_links(@facets, key, @filters),
                links != [] do %>
          <section id={"facet-#{key}"}>
            <h3 class="mb-2 text-xs font-bold uppercase tracking-[0.15em] text-stone-400">
              {KirbsWeb.Shop.Labels.facet_title(key)}
            </h3>
            <ul class="flex flex-wrap gap-1.5">
              <li :for={{value, label, count} <- links}>
                <.link
                  id={"facet-#{key}-#{value}"}
                  patch={shop_path(@tree, @category, toggle_filter(@filters, key, value))}
                  class={[
                    "inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-sm transition",
                    if(to_string(@filters[key]) == to_string(value),
                      do: "border-orange-500 bg-orange-500 font-bold text-white",
                      else:
                        "border-orange-200 bg-white text-stone-600 hover:border-orange-400 hover:text-orange-600"
                    )
                  ]}
                >
                  {label} <span class="text-xs opacity-60">{count}</span>
                </.link>
              </li>
            </ul>
          </section>
        <% end %>

        <%!-- Size --%>
        <section :if={@facets.size != [] or @filters[:size]} id="facet-size">
          <h3 class="mb-2 text-xs font-bold uppercase tracking-[0.15em] text-stone-400">
            Suurus
          </h3>
          <ul class="flex flex-wrap gap-1.5">
            <li :for={
              {value, label, count} <- sorted_sizes(facet_links(@facets, :size, @filters))
            }>
              <.link
                id={"facet-size-#{value}"}
                patch={shop_path(@tree, @category, toggle_filter(@filters, :size, value))}
                title={"#{count} eset"}
                class={[
                  "inline-flex min-w-10 items-center justify-center rounded-lg border px-2.5 py-1 text-sm font-semibold transition",
                  if(@filters[:size] == value,
                    do: "border-orange-500 bg-orange-500 text-white",
                    else:
                      "border-orange-200 bg-white text-stone-600 hover:border-orange-400 hover:text-orange-600"
                  )
                ]}
              >
                {label}
              </.link>
            </li>
          </ul>
        </section>

        <%!-- Brand --%>
        <section :if={@facets.brand != [] or @filters[:brand]} id="facet-brand">
          <h3 class="mb-2 text-xs font-bold uppercase tracking-[0.15em] text-stone-400">
            Bränd
          </h3>
          <ul class="max-h-64 space-y-0.5 overflow-y-auto pr-1">
            <li :for={{value, label, count} <- facet_links(@facets, :brand, @filters)}>
              <.link
                id={"facet-brand-#{String.replace(value, ~r/[^a-zA-Z0-9]+/, "-")}"}
                patch={shop_path(@tree, @category, toggle_filter(@filters, :brand, value))}
                class={[
                  "flex items-center justify-between rounded-lg px-2.5 py-1.5 text-sm transition-colors",
                  if(@filters[:brand] == value,
                    do: "bg-orange-100 font-bold text-orange-700",
                    else: "text-stone-600 hover:bg-orange-50 hover:text-orange-600"
                  )
                ]}
              >
                <span class="truncate">{label}</span>
                <span class="ml-2 text-xs text-stone-400">{count}</span>
              </.link>
            </li>
          </ul>
        </section>

        <%!-- Price --%>
        <section id="facet-price">
          <h3 class="mb-2 text-xs font-bold uppercase tracking-[0.15em] text-stone-400">
            Hind (€)
          </h3>
          <.form
            for={@price_form}
            id="shop-price-form"
            phx-submit="price"
            class="flex items-center gap-2"
          >
            <.input
              field={@price_form[:min_price]}
              type="number"
              min="0"
              step="1"
              placeholder="alates"
              class="w-full rounded-lg border border-orange-200 bg-white px-3 py-1.5 text-sm outline-none focus:border-orange-400 focus:ring-2 focus:ring-orange-200"
            />
            <span class="mb-2 text-stone-300">–</span>
            <.input
              field={@price_form[:max_price]}
              type="number"
              min="0"
              step="1"
              placeholder="kuni"
              class="w-full rounded-lg border border-orange-200 bg-white px-3 py-1.5 text-sm outline-none focus:border-orange-400 focus:ring-2 focus:ring-orange-200"
            />
            <button
              id="shop-price-submit"
              type="submit"
              class="mb-2 rounded-lg bg-stone-800 px-3 py-1.5 text-sm font-bold text-white transition hover:bg-orange-500"
              aria-label="Rakenda hinnafilter"
            >
              <.icon name="hero-check-micro" class="size-4" />
            </button>
          </.form>
        </section>
      </div>
    </aside>

    <section aria-label="Tooted">
      <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
        <div id="active-filters" class="flex flex-wrap items-center gap-2">
          <%= for {key, label} <- active_chips(@filters) do %>
            <.link
              id={"chip-#{key}"}
              patch={shop_path(@tree, @category, Map.delete(@filters, key))}
              class="group inline-flex items-center gap-1 rounded-full bg-orange-100 px-3 py-1 text-sm font-semibold text-orange-700 transition hover:bg-orange-200"
            >
              {label}
              <.icon name="hero-x-mark-micro" class="size-4 opacity-60 group-hover:opacity-100" />
            </.link>
          <% end %>
          <.link
            :if={length(active_chips(@filters)) > 1}
            id="clear-filters"
            patch={shop_path(@tree, @category, %{})}
            class="text-sm text-stone-500 underline-offset-2 hover:text-orange-600 hover:underline"
          >
            Tühista kõik
          </.link>
        </div>

        <.form for={@sort_form} id="shop-sort-form" phx-change="sort" class="ml-auto">
          <.input
            field={@sort_form[:sort]}
            type="select"
            options={sort_options(@filters)}
            aria-label="Sorteeri"
            class="rounded-full border border-orange-200 bg-white py-2 pl-4 pr-9 text-sm font-semibold text-stone-700 outline-none focus:border-orange-400 focus:ring-2 focus:ring-orange-200"
          />
        </.form>
      </div>

      <div
        id="shop-items"
        phx-update="stream"
        class="grid grid-cols-2 gap-x-3 gap-y-7 sm:grid-cols-3 sm:gap-x-5 xl:grid-cols-4"
      >
        <div
          id="shop-empty"
          class="col-span-full hidden rounded-3xl border border-dashed border-orange-200 bg-white/60 px-6 py-16 text-center only:block"
        >
          <.icon name="hero-face-frown" class="mx-auto size-10 text-orange-300" />
          <p class="mt-3 font-bold text-stone-800">Midagi sobivat ei leidnud</p>
          <p class="mt-1 text-sm text-stone-500">
            Proovi otsingut lühendada või filtreid eemaldada.
          </p>
          <.link
            patch={shop_path(@tree, nil, %{})}
            class="mt-5 inline-block rounded-full bg-orange-500 px-5 py-2 text-sm font-bold text-white transition hover:bg-orange-600"
          >
            Näita kõiki tooteid
          </.link>
        </div>
        <.item_card :for={{dom_id, item} <- @streams.items} id={dom_id} item={item} />
      </div>

      <div :if={@more?} class="mt-10 flex justify-center">
        <button
          id="load-more"
          type="button"
          phx-click="load_more"
          phx-disable-with="Laen …"
          class="rounded-full border-2 border-orange-500 px-8 py-2.5 text-sm font-extrabold text-orange-600 transition hover:bg-orange-500 hover:text-white"
        >
          Näita rohkem
        </button>
      </div>
    </section>
  </div>
</Layouts.app>
