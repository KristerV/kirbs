import Config

# OpenRouter API key
# Get your API key from: https://openrouter.ai/keys
config :kirbs,
  openrouter_api_key: "your-openrouter-api-key-here"

# Montonio sandbox (payments + shipping)
# Partner system -> Settings -> API keys (use the sandbox environment)
config :kirbs, :montonio,
  access_key: "your-montonio-sandbox-access-key",
  secret_key: "your-montonio-sandbox-secret-key",
  env: :sandbox
